{
  "asyncapi": "2.6.0",
  "channels": {
    "audit.event": {
      "subscribe": {
        "message": {
          "name": "AuditEvent",
          "payload": {
            "$ref": "#/components/schemas/AuditEvent"
          }
        },
        "operationId": "audit_event"
      }
    },
    "guardrail.decision": {
      "subscribe": {
        "message": {
          "name": "GuardrailDecisionEvent",
          "payload": {
            "$ref": "#/components/schemas/GuardrailDecisionEvent"
          }
        },
        "operationId": "guardrail_decision"
      }
    },
    "opc.write.requested": {
      "subscribe": {
        "message": {
          "name": "OpcWriteRequestedEvent",
          "payload": {
            "$ref": "#/components/schemas/OpcWriteRequestedEvent"
          }
        },
        "operationId": "opc_write_requested"
      }
    },
    "reflection.requested": {
      "subscribe": {
        "message": {
          "name": "ReflectionRequestedEvent",
          "payload": {
            "$ref": "#/components/schemas/ReflectionRequestedEvent"
          }
        },
        "operationId": "reflection_requested"
      }
    },
    "seat.task.completed": {
      "subscribe": {
        "message": {
          "name": "SeatTaskCompletedEvent",
          "payload": {
            "$ref": "#/components/schemas/SeatTaskCompletedEvent"
          }
        },
        "operationId": "seat_task_completed"
      }
    },
    "seat.task.created": {
      "subscribe": {
        "message": {
          "name": "SeatTaskCreatedEvent",
          "payload": {
            "$ref": "#/components/schemas/SeatTaskCreatedEvent"
          }
        },
        "operationId": "seat_task_created"
      }
    },
    "tasks/{task_id}/stream": {
      "parameters": {
        "task_id": {
          "schema": {
            "type": "string"
          }
        }
      },
      "subscribe": {
        "message": {
          "name": "TaskStream",
          "payload": {
            "properties": {
              "event": {
                "type": "string"
              },
              "schema_version": {
                "type": "string"
              },
              "tenant_id": {
                "type": "string"
              },
              "trace_id": {
                "type": "string"
              }
            },
            "required": [
              "schema_version",
              "trace_id",
              "tenant_id",
              "event"
            ],
            "type": "object"
          }
        },
        "operationId": "watchTask"
      }
    }
  },
  "components": {
    "schemas": {
      "AuditEvent": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "title": "Action",
            "type": "string"
          },
          "event": {
            "$ref": "#/components/schemas/EventName",
            "default": "audit.event"
          },
          "object_key": {
            "default": "",
            "title": "Object Key",
            "type": "string"
          },
          "occurred_at": {
            "maxLength": 40,
            "minLength": 20,
            "title": "Occurred At",
            "type": "string"
          },
          "schema_version": {
            "default": "1.0.0",
            "title": "Schema Version",
            "type": "string"
          },
          "tenant_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
            "title": "Tenant Id",
            "type": "string"
          },
          "trace_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "title": "Trace Id",
            "type": "string"
          }
        },
        "required": [
          "trace_id",
          "tenant_id",
          "occurred_at",
          "action"
        ],
        "title": "AuditEvent",
        "type": "object"
      },
      "EventName": {
        "enum": [
          "seat.task.created",
          "seat.task.completed",
          "reflection.requested",
          "guardrail.decision",
          "audit.event",
          "opc.write.requested"
        ],
        "title": "EventName",
        "type": "string"
      },
      "GuardrailDecisionEvent": {
        "additionalProperties": false,
        "properties": {
          "decision_id": {
            "title": "Decision Id",
            "type": "string"
          },
          "event": {
            "$ref": "#/components/schemas/EventName",
            "default": "guardrail.decision"
          },
          "occurred_at": {
            "maxLength": 40,
            "minLength": 20,
            "title": "Occurred At",
            "type": "string"
          },
          "policy_version": {
            "title": "Policy Version",
            "type": "string"
          },
          "schema_version": {
            "default": "1.0.0",
            "title": "Schema Version",
            "type": "string"
          },
          "tenant_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
            "title": "Tenant Id",
            "type": "string"
          },
          "trace_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "title": "Trace Id",
            "type": "string"
          },
          "verdict": {
            "$ref": "#/components/schemas/GuardrailVerdict"
          }
        },
        "required": [
          "trace_id",
          "tenant_id",
          "occurred_at",
          "decision_id",
          "verdict",
          "policy_version"
        ],
        "title": "GuardrailDecisionEvent",
        "type": "object"
      },
      "GuardrailVerdict": {
        "enum": [
          "allow",
          "deny",
          "confirm"
        ],
        "title": "GuardrailVerdict",
        "type": "string"
      },
      "OpcWriteRequestedEvent": {
        "additionalProperties": false,
        "properties": {
          "event": {
            "$ref": "#/components/schemas/EventName",
            "default": "opc.write.requested"
          },
          "guardrail_decision_id": {
            "title": "Guardrail Decision Id",
            "type": "string"
          },
          "node_id": {
            "title": "Node Id",
            "type": "string"
          },
          "occurred_at": {
            "maxLength": 40,
            "minLength": 20,
            "title": "Occurred At",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "schema_version": {
            "default": "1.0.0",
            "title": "Schema Version",
            "type": "string"
          },
          "tenant_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
            "title": "Tenant Id",
            "type": "string"
          },
          "trace_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "title": "Trace Id",
            "type": "string"
          }
        },
        "required": [
          "trace_id",
          "tenant_id",
          "occurred_at",
          "request_id",
          "node_id",
          "guardrail_decision_id"
        ],
        "title": "OpcWriteRequestedEvent",
        "type": "object"
      },
      "ReflectionRequestedEvent": {
        "additionalProperties": false,
        "properties": {
          "event": {
            "$ref": "#/components/schemas/EventName",
            "default": "reflection.requested"
          },
          "occurred_at": {
            "maxLength": 40,
            "minLength": 20,
            "title": "Occurred At",
            "type": "string"
          },
          "schema_version": {
            "default": "1.0.0",
            "title": "Schema Version",
            "type": "string"
          },
          "sync": {
            "default": false,
            "title": "Sync",
            "type": "boolean"
          },
          "task_id": {
            "title": "Task Id",
            "type": "string"
          },
          "tenant_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
            "title": "Tenant Id",
            "type": "string"
          },
          "trace_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "title": "Trace Id",
            "type": "string"
          }
        },
        "required": [
          "trace_id",
          "tenant_id",
          "occurred_at",
          "task_id"
        ],
        "title": "ReflectionRequestedEvent",
        "type": "object"
      },
      "SeatTaskCompletedEvent": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "default": "",
            "title": "Detail",
            "type": "string"
          },
          "event": {
            "$ref": "#/components/schemas/EventName",
            "default": "seat.task.completed"
          },
          "occurred_at": {
            "maxLength": 40,
            "minLength": 20,
            "title": "Occurred At",
            "type": "string"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          },
          "schema_version": {
            "default": "1.0.0",
            "title": "Schema Version",
            "type": "string"
          },
          "seat_id": {
            "title": "Seat Id",
            "type": "string"
          },
          "task_id": {
            "title": "Task Id",
            "type": "string"
          },
          "tenant_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
            "title": "Tenant Id",
            "type": "string"
          },
          "trace_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "title": "Trace Id",
            "type": "string"
          },
          "work_item_id": {
            "title": "Work Item Id",
            "type": "string"
          }
        },
        "required": [
          "trace_id",
          "tenant_id",
          "occurred_at",
          "task_id",
          "seat_id",
          "work_item_id",
          "ok"
        ],
        "title": "SeatTaskCompletedEvent",
        "type": "object"
      },
      "SeatTaskCreatedEvent": {
        "additionalProperties": false,
        "properties": {
          "event": {
            "$ref": "#/components/schemas/EventName",
            "default": "seat.task.created"
          },
          "idempotency_key": {
            "maxLength": 128,
            "minLength": 8,
            "title": "Idempotency Key",
            "type": "string"
          },
          "occurred_at": {
            "maxLength": 40,
            "minLength": 20,
            "title": "Occurred At",
            "type": "string"
          },
          "schema_version": {
            "default": "1.0.0",
            "title": "Schema Version",
            "type": "string"
          },
          "seat_id": {
            "title": "Seat Id",
            "type": "string"
          },
          "task_id": {
            "title": "Task Id",
            "type": "string"
          },
          "tenant_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
            "title": "Tenant Id",
            "type": "string"
          },
          "trace_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "title": "Trace Id",
            "type": "string"
          },
          "work_item_id": {
            "title": "Work Item Id",
            "type": "string"
          }
        },
        "required": [
          "trace_id",
          "tenant_id",
          "occurred_at",
          "task_id",
          "seat_id",
          "work_item_id",
          "idempotency_key"
        ],
        "title": "SeatTaskCreatedEvent",
        "type": "object"
      }
    }
  },
  "defaultContentType": "application/json",
  "info": {
    "description": "NATS JetStream。頻道名即事件名。",
    "title": "Linkin 事件契約",
    "version": "2026-10-26"
  },
  "servers": {
    "nats": {
      "protocol": "nats",
      "url": "nats.linkin.svc.cluster.local:4222"
    }
  }
}
