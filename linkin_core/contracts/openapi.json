  "info": {
    "description": "內網 BFF 與內部服務的草案。現有 /chat、/tasks 繼續由單體提供，此檔不取代實作。AI Hub 的 /api/v1/chat/completions 是另一條契約。",
    "title": "Linkin 服務契約",
    "version": "2026-10-26"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/chat/stream": {
      "post": {
        "deprecated": false,
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatStreamRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatSseEvent"
                }
              }
            },
            "description": "對話 SSE。首個事件為 route，其後為 token。"
          },
          "400": {
            "$ref": "#/components/responses/Error"
          }
        },
        "summary": "對話 SSE。首個事件為 route，其後為 token。",
        "x-linkin-visibility": "public"
      }
    },
    "/api/v1/guardrail/approve": {
      "post": {
        "deprecated": false,
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GuardrailApproveRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GuardrailDecision"
                }
              }
            },
            "description": "人工審批 OPC 寫入或危險 Minecraft 動作"
          },
          "400": {
            "$ref": "#/components/responses/Error"
          }
