{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node -e \"const {spawnSync}=require('child_process');const py=['python3','python'].find(c=>!spawnSync(c,['--version'],{stdio:'ignore'}).error)||'python3';const r=spawnSync(py,['../backend/scripts/export_monitor_fallback.py'],{stdio:'inherit',shell:false});process.exit(r.status??1)\"",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "openapi": "python ../backend/scripts/export_openapi.py",
    "archify:doctor": "node ./node_modules/archify/bin/archify.mjs doctor",
    "archify:render": "node ./node_modules/archify/bin/archify.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@xyflow/react": "^12.11.5",
    "archify": "file:../vendor/archify",
    "echarts": "^6.1.0",
    "i18next": "^26.4.0",
    "mermaid": "^11.17.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "react-is": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.12",
    "tailwindcss": "^4.3.3",
    "three": "^0.180.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^3.2.7"
  }
}
