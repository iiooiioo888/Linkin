# ===== LLM 服務 =====
OPENAI_API_KEY=sk-your-key-here
# 可選端點：DeepSeek / OpenRouter / Ollama / vLLM 相容等
# OPENAI_API_BASE=https://api.deepseek.com
# OPENAI_API_BASE=https://openrouter.ai/api/v1
# LiteLLM 模型名稱（會被模型池 clamp；單一廠商時請填該廠商模型）
EVOL_MODEL=gpt-4o
# 反思迴圈參數
EVOL_PASS_THRESHOLD=8
EVOL_MAX_ITERATIONS=3
# EVOL_MIN_SCORE_IMPROVEMENT=0.5
# EVOL_CROSS_EVAL_MODEL=
# EVOL_CROSS_EVAL_AUTO=false

# ===== P0 环节-模型匹配 =====
# EVOL_STAGE_TIER_GENERATE=routine
# EVOL_STAGE_TIER_EVALUATE=summary
# EVOL_STAGE_TIER_REFLECT=reasoning
# EVOL_STAGE_TIER_IMPROVE=routine

# ===== P1 Reviewer+Synthesizer 合并 =====
# EVOL_MERGE_REVIEW_SYNTH=true

# ===== P2 路由自适应 / OPC 边缘-云 =====
# EVOL_ROUTING_FEEDBACK_PATH=backend/data/routing_feedback.json
# EVOL_OPC_TIER=auto
# EVOL_OPC_EDGE_TTL=5

# ===== 模型池運維 =====
# 背景定時爬取通用端點 /models（OpenRouter 等）
EVOL_LLM_OPS_ENABLED=true
EVOL_LLM_OPS_INTERVAL_SEC=300

# ===== 角色目錄 =====
# EVOL_ROLE_CATALOG_PATH=backend/data/role_catalog.json

# ===== A/B 評估（Phase 12） =====
# 實驗持久化路徑
# EVOL_AB_STORE_PATH=backend/data/ab_experiments.json
# 單次實驗案例數上限（防止跑爆預算）
# EVOL_AB_MAX_CASES=20
# 平手邊界：兩變體總分差 ≤ 此值記平手
# EVOL_AB_TIE_MARGIN=0.5

# ===== 靈境·LLM 建築設計 =====
# 讓 LLM 理解自然語言需求設計 3D 建築（關掉或無金鑰時自動降級程序化生成）
# EVOL_LINKIN_LLM_DESIGN=true
# 明確停用一切靈境 LLM 呼叫（NPC 對話／任務／建築設計）
# EVOL_LINKIN_NO_LLM=false

# ===== LLM 快取 =====
# EVOL_LLM_CACHE_SIZE=512
# EVOL_LLM_CACHE_TTL=3600
# EVOL_SEMANTIC_CACHE=true
# EVOL_SEMANTIC_THRESHOLD=0.92

# ===== 後端服務 =====
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
REDIS_URL=redis://localhost:6379/0

# ===== 文本化存檔（選填） =====
# EVOL_ARCHIVE_DIR=

# ===== 向量資料庫 =====
CHROMA_HOST=localhost
CHROMA_PORT=8100

# ===== 上下文截斷（選填） =====
# EVOL_MAX_CONTEXT_CHARS=6000
# EVOL_MAX_ANSWER_CHARS=4000
# EVOL_DECOMPOSE_CACHE_SIZE=64

# ===== 阿里雲 BSS（費用／用量，納入 Agent 雲資源預算） =====
# ALIYUN_ACCESS_KEY_ID=
# ALIYUN_ACCESS_KEY_SECRET=
# ALIYUN_BSS_ENDPOINT=https://business.aliyun.com
# ALIYUN_CNY_USD_RATE=0.14
# ALIYUN_BSS_CACHE_SEC=120

# ===== Minecraft MCP（MineMCP Paper 插件） =====
# Paper 1.21 安裝 MineMCP 後再開啟。未設 TOKEN 時公司工具走乾跑，不寫入世界。
# EVOL_MC_MCP_ENABLED=false
# EVOL_MC_MCP_URL=http://127.0.0.1:3000
# EVOL_MC_MCP_TOKEN=
# EVOL_MC_MCP_RPC_PATH=/sse
# EVOL_MC_MCP_WORLD=world
# EVOL_MC_MCP_MAX_FILL=5000

# ===== 服務器運維智能體（AIOps，/linkin/server/*） =====
# 設 true 才允許真實刪除／輪轉／重啟／備份；預設乾跑（寫操作只模擬）
# EVOL_SA_ENABLED=false
# 受管存儲根（清理／備份／磁盤分析的路徑牢籠，越界一律拒絕）
# EVOL_SA_STORAGE_ROOT=/data/mmorpg
# 增量備份目標目錄（預設 STORAGE_ROOT/backups）
# EVOL_SA_BACKUP_DIR=
# JSONL 審計日誌路徑
# EVOL_SA_AUDIT_PATH=backend/data/linkin/server_audit.jsonl
# 待批准隊列路徑與有效期（分鐘，過期自動作廢）
# EVOL_SA_PENDING_PATH=backend/data/linkin/server_pending.json
# EVOL_SA_PENDING_TTL_MIN=30
# 雙重開關：API auto_approve=true 且此項=true 才允許跳過人工批准（不建議）
# EVOL_SA_AUTO_APPROVE=false
# 允許重啟／查詢的 systemd 服務白名單（逗號分隔）
# EVOL_SA_SERVICES=linkin-api,mysql,redis-server,nginx
# 強制關閉運維 LLM 規劃（關鍵詞路由兜底，無金鑰時自動等效）
# EVOL_SA_NO_LLM=false
# 運維規劃模型（預設走 stage_router 的 generate 層級）
# EVOL_SA_MODEL=
# 巡檢磁盤告警閾值 %（超過則提案清理）
# EVOL_SA_DISK_WARN=80

# ===== OPC UA 工業微服務 =====
OPC_SERVER_URL=opc.tcp://localhost:4840/freeopcua/server/
OPC_SERVICE_HOST=0.0.0.0
OPC_SERVICE_PORT=8001
# OPC_WRITE_WHITELIST=Temperature,Pressure,ValvePosition,MotorSpeed
# OPC_SIM_ENABLED=true
# OPC_SIM_PORT=4840
# OPC_SERVICE_URL=http://localhost:8001
# OPC_STAGE_TIMEOUT=30
# OPC_ACT_HUMAN_CONFIRM=false
